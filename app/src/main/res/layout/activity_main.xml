<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_wallpaper"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Wi-Fi status -->
            <ImageView
                android:id="@+id/wifiIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="@string/wi_fi_status" />

            <!-- Left separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="20dp"
                android:background="#55FFFFFF" />

            <!-- Home tab -->
            <TextView
                android:id="@+id/tabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Apps tab -->
            <TextView
                android:id="@+id/tabApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tab_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Apps"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Flexible space -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Clock -->
            <TextClock
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Date -->
            <TextClock
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:format12Hour="EEEE, MMM d"
                android:format24Hour="EEEE, MMM d"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

            <!-- Weather -->
            <LinearLayout
                android:id="@+id/weatherContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Weather. Select to enable local weather">

                <TextView
                    android:id="@+id/weatherIcon"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/weatherTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap for weather"
                        android:textColor="#A8A8B8"
                        android:textSize="11sp"
                        android:maxLines="1" />

                </LinearLayout>

            </LinearLayout>

            <!-- Right separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="20dp"
                android:background="#55FFFFFF" />

            <!-- Settings -->
            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/open_settings"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Favorites heading -->
        <LinearLayout
            android:id="@+id/favoritesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#35FFFFFF" />

            <TextView
                android:id="@+id/favoritesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/favorites"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Scrollable application grid -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/appGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:useDefaultMargins="false" />

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
